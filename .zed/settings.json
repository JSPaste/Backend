// -*- mode: jsonc -*-
{
  // lsp
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": ".oxfmtrc.json",
          "run": "onSave"
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": ".oxlintrc.json",
          "run": "onSave",
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "keyOrdering": false,
          "format": {
            "singleQuote": false
          }
        }
      }
    }
  },
  // language specific (overrides global)
  "languages": {
    "JSON": {
      "formatter": "language_server",
      "language_servers": ["oxfmt", "json-language-server"]
    },
    "JSONC": {
      "formatter": "language_server",
      "language_servers": ["oxfmt", "json-language-server"]
    },
    "JavaScript": {
      "formatter": "language_server",
      "language_servers": ["oxfmt", "deno"]
    },
    "Markdown": {
      "formatter": "language_server",
      "language_servers": ["oxfmt"]
    },
    "TypeScript": {
      "formatter": "language_server",
      "language_servers": ["oxfmt", "deno"]
    },
    "YAML": {
      "formatter": "language_server",
      "language_servers": ["oxfmt"]
    }
  }
}